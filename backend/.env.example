# Copy this file to .env for local development (without Docker)
# When running via Docker Compose, variables are injected from the root .env instead

DATABASE_URL=postgresql://migx:migx@localhost:5432/migx

# Generate a strong random value for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
